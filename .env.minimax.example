# 国内开放平台 MiniMax + 本机中文向量。此文件不会自动加载，不包含真实密钥。
# 推荐运行 scripts/configure-minimax.py，由隐藏输入写入 .env.local 并保留其他配置。
AI_PROVIDER=minimax
AI_BASE_URL=https://api.minimax.cn/v1
AI_API_KEY=
AI_TEXT_MODEL=MiniMax-M3
AI_VISION_MODEL=MiniMax-M3
AI_ASR_MODEL=asr-1.0
AI_EMBEDDING_PROVIDER=local
AI_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
AI_EMBEDDING_DIMENSION=512
CLOUD_CALLS_ENABLED=false
