# scripts/init.ps1 自动生成随机本机密码；此文件不包含真实凭据。
APP_ENV=development
APP_TIMEZONE=Asia/Hong_Kong
APP_BASE_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173
ADMIN_PASSWORD=CHANGE_ME_USE_INIT_SCRIPT
COOKIE_SECURE=false
# 仅直接回环访问可免密；远程与代理访问继续认证。
LOCAL_PASSWORDLESS=false
POSTGRES_DB=creator_knowledge
POSTGRES_USER=creator_knowledge
POSTGRES_PASSWORD=CHANGE_ME_USE_INIT_SCRIPT
DATA_DIR=./data
BACKUP_DIR=./backups
REDIS_URL=redis://redis:6379/0
TASK_MODE=local
AI_PROVIDER=mock
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_TEXT_MODEL=
AI_VISION_MODEL=
AI_ASR_MODEL=
AI_EMBEDDING_MODEL=
AI_EMBEDDING_DIMENSION=96
# MiniMax 可使用 local 本机向量；api 表示独立兼容 Embedding 服务。
AI_EMBEDDING_PROVIDER=api
AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_API_KEY=
CLOUD_CALLS_ENABLED=false
ADAPTER_DOUYIN_MODE=mock
ADAPTER_XHS_MODE=mock
PLATFORM_REQUESTS_ENABLED=false
# 本机 Personal Brain：仅同步已完成的非 Mock 知识，目标使用自己的本机模型。
BRAIN_SYNC_ENABLED=false
BRAIN_BASE_URL=http://127.0.0.1:8001
# 二次学习：使用已配置的文字模型，结果独立保存为待验证的 AI 推论。
REFLECTION_ENABLED=false
REFLECTION_PROVIDER=configured
# 本机抖音采集：ADAPTER_DOUYIN_MODE=browser，并启用 PLATFORM_REQUESTS_ENABLED。
DOUYIN_BROWSER_CHANNEL=msedge
DOUYIN_NODE_PATH=node
DOUYIN_BROWSER_TIMEOUT=60
REPORT_HOUR=23
REPORT_MINUTE=55
MIN_FREE_SPACE_MB=256
MAX_UPLOAD_MB=250
FRAME_INTERVAL=15
MAX_FRAMES=24
